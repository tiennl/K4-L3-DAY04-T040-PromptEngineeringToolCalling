      "phase": "B",
      "suite": "group",
      "query": "Kiểm tra Wi-Fi trên laptop của tôi giúp nhé.",
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "text"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Không được tự đoán asset ID từ mô tả chung; phải hỏi asset ID."
      }
    },
    {
