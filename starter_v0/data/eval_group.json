        "tool_calls": [
          {
            "name": "inspect_device",
            "args": {
              "asset_id": "LT-240",
              "check": "vpn"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Dùng phạm vi kiểm tra vpn được yêu cầu thay vì mặc định all."
